llm:
  # provider options: local (vLLM) | openai | anthropic
  provider: local
  base_url: http://localhost:11434/v1   # only used for provider: local
  api_key: ""                           # or set OPENAI_API_KEY / ANTHROPIC_API_KEY env var

fleet:
  - name: ur3e
    model_type: ur3e
    ip: 192.168.1.2
    arm_mcp_url: http://localhost:8765/mcp
    gripper_mcp_url: http://localhost:8001/mcp   # omit if no end-effector

agents:
  orchestrator:
    model: qwen2.5:72b      # or gpt-4o, claude-sonnet-4-6
  scenario:
    model: qwen2.5:14b
  config:
    model: qwen2.5:14b
  safety:
    model: qwen2.5:7b
    poll_interval_sec: 1.0
    alert_threshold: WARNING   # WARNING | BLOCKED
  vision:
    model: gemini-robotics-er-1.6-preview   # agent reasoning model; for openai_vision use e.g. llava or cosmos-reason2
    detector: gemini                        # "gemini" | "openai_vision" (any OpenAI-compatible vision endpoint via llm.base_url)
    google_api_key: ""                      # required for detector: gemini — or set GOOGLE_API_KEY env var
    ik_solver: robot                        # "robot" = use robot MCP get_inverse_kin | "local" = analytical solver
    pick_x_offset_m: 0.0       # tune to correct systematic grasp X error (metres, positive = away from robot base)
    pick_y_offset_m: 0.0       # tune to correct systematic grasp Y error (metres, positive = robot's right)

scenarios:
  store_path: ./cobot/scenarios/store

rag:
  manuals_path: ./manuals
  db_path: ./chroma_db
  chunk_size: 512
  chunk_overlap: 64

observability:
  enabled: false
  token: ""     # Logfire project token — or set LOGFIRE_TOKEN env var
